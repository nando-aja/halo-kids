# HaloKids Backend Configuration Template
PROJECT_NAME=HaloKids Backend

# Database Utama (MySQL lokal / XAMPP / TiDB)
DATABASE_URL=mysql+pymysql://root:@127.0.0.1:3306/halokids_db

# JWT & Keamanan
SECRET_KEY=halokids_jwt_secret_key_production_safe_2026_xyz123
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS Whitelist (Frontend Vite default 5173 / React 3000)
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# Supabase Storage (Opsional - Jika kosong, otomatis fallback ke Local Storage)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_PRIVATE_BUCKET=halokids-private
SUPABASE_PUBLIC_BUCKET=halokids-public

# Tesseract OCR (Opsional jika executable terpasang di path default)
# TESSERACT_CMD=C:/Program Files/Tesseract-OCR/tesseract.exe
